// Government / statutory approvals managed by the Liaison department (RERA, LDC, CLU, NOC, licenses,
// agreements, government letters). Version history is modelled by chaining: uploading a newer version
// creates a new row (version + 1) and marks the previous one ARCHIVED with supersededById set.
model ApprovalDocument {
  id             String    @id @default(cuid())
  tenantId       String
  projectId      String?
  type           String
  title          String
  number         String?
  authority      String?
  issuedAt       DateTime?
  expiresAt      DateTime?
  version        Int       @default(1)
  supersededById String?
  fileAssetId    String?
  status         String    @default("ACTIVE")
  notes          String?
  createdById    String?
  archivedAt     DateTime?
  lastReminderAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project Project? @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId, type])
  @@index([tenantId, status, expiresAt])
}

