generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PLATFORM_ADMIN
  BUILDER_OWNER
  BUILDER_ADMIN
  SITE_ENGINEER
  FINANCE_MANAGER
  MARKETING_HEAD
  VIDEOGRAPHER
  EDITOR
  CONTRACTOR
  PLOT_OWNER
  VIEWER
  SUPER_ADMIN
  ALLOTMENT_EXECUTIVE
  APPROVING_AUTHORITY
  AUTHORIZED_SIGNATORY
  HEAD_ENGINEER
  LIAISON_OFFICER
}

enum UserStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum UserFieldType {
  TEXT
  IMAGE
  DOCUMENT
}

enum OwnerType {
  INDIVIDUAL
  COMPANY
  SHARED
}

enum PlotStatus {
  COMPANY_OWNED
  ALLOTTED
  TRANSFERRED
  REGISTRY_IN_PROGRESS
  REGISTERED
  HOLD
}

enum OwnershipKind {
  COMPANY_INVENTORY
  ALLOTMENT
  TRANSFER
  REGISTRY
}

enum CadFormat {
  DWG
  DXF
  VECTOR_PDF
}

enum CadStatus {
  UPLOADED
  CONVERTING
  PARSING
  ANALYZING
  SETUP_REQUIRED
  EXTRACTING
  CALIBRATION_REQUIRED
  REVIEW_REQUIRED
  PUBLISHED
  FAILED
}

enum CadScope {
  PROJECT
  PLOT
  UNIT
  FLOOR
  ROOM
  SITE_ASSET
}

enum CadEntityType {
  PLOT
  ROAD
  BOUNDARY
  UTILITY
  PARK
  GATE
  CLUBHOUSE
  DRAINAGE
  ROOM
  BATHROOM
  KITCHEN
  STAIRCASE
  PARKING
  GARDEN
  WALL
  DOOR
  WINDOW
  ELECTRICAL_POINT
  PLUMBING_LINE
  STRUCTURE
  FINISHING_ZONE
  UNKNOWN
}

enum CadExtractionStatus {
  CREATED
  UPLOADING
  VALIDATING
  COMPLETED
  FAILED
  CANCELLED
}

enum DocumentStatus {
  DRAFT
  GENERATED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  ISSUED
  SUBMITTED
  SENT_FOR_SIGNATURE
  SIGNED
}

enum FileVisibility {
  ADMIN_ONLY
  TEAM
  OWNER_VISIBLE
  SHARED
}

enum FileStorageProvider {
  S3
  LOCAL
}

enum RealEstateDocumentType {
  ALLOTMENT_LETTER
  TRANSFER_LETTER
  PAN_CARD
  AADHAAR_CARD
  REGISTRY_RECEIPT
  REGISTRY_DEED
  PAYMENT_RECEIPT
  KYC
  AGREEMENT
  NOC
  OTHER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum MarketingTaskStatus {
  TODO
  SHOOT_ASSIGNED
  RAW_UPLOADED
  EDIT_ASSIGNED
  DRAFT_UPLOADED
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  ON_HOLD
}

enum InsightSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  UPLOAD
  REVIEW
  PUBLISH
  APPROVE
  REJECT
  TRANSFER
  ALLOT
  REGISTRY_UPDATE
  PROGRESS_UPDATE
  SUBMIT
  SIGN
  ASSIGN
  VERIFY
  RETURN
}

enum CrmLeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  INTERESTED
  FOLLOW_UP_REQUIRED
  VISIT_PROPOSED
  VISIT_SCHEDULED
  VISIT_COMPLETED
  NEGOTIATION
  BOOKING_PENDING
  BOOKED
  CUSTOMER
  NOT_INTERESTED
  FUTURE_PROSPECT
  LOST
  INVALID
}

enum CrmLeadPotential {
  COLD
  WARM
  HOT
  VERY_HOT
}

enum CrmActivityType {
  LEAD_CREATED
  INCOMING_CALL
  OUTGOING_CALL
  NOTE
  STATUS_CHANGED
  POTENTIAL_CHANGED
  ASSIGNED
  FOLLOW_UP_CREATED
  FOLLOW_UP_COMPLETED
  VISIT_PROPOSED
  VISIT_SCHEDULED
  VISIT_COMPLETED
  VISIT_CANCELLED
  MESSAGE_OPENED
  FEEDBACK_RECEIVED
  BOOKING_CREATED
  CUSTOMER_CONVERTED
  MERGED
  TICKET_CREATED
  TICKET_UPDATED
}

enum CrmFollowUpStatus {
  PENDING
  COMPLETED
  RESCHEDULED
  CANCELLED
  OVERDUE
}

enum CrmVisitStatus {
  PROPOSED
  SCHEDULED
  CONFIRMED
  VISITED
  DID_NOT_VISIT
  RESCHEDULED
  CANCELLED
}

enum CrmBookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum CrmTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Tenant {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  region              String?
  gstin               String?
  pan                 String?
  contactEmail        String?
  contactPhone        String?
  logoFileId          String?
  logoDataUrl         String?
  address             String?
  authorizedPersons   Json?
  editKeyHash         String?
  customFields        Json?
  letterhead          Json?
  maxTransfersPerPlot Int      @default(3)
  crmUrl              String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  users                 User[]
  projects              Project[]
  owners                Owner[]
  files                 FileAsset[]
  auditEvents           AuditEvent[]
  memberships           UserFirmMembership[]
  projectMemberships    UserProjectMembership[]
  departments           Department[]
  designations          Designation[]
  customRoles           CustomRole[]
  userFieldDefinitions  UserFieldDefinition[]
  projectFileFields     ProjectFileField[]
  letterFieldCategories LetterFieldCategory[]
}

model User {
  id            String     @id @default(cuid())
  tenantId      String?
  email         String     @unique
  loginId       String?    @unique
  passwordHash  String
  name          String
  phone         String?
  role          Role
  customRoleId  String?
  departmentId  String?
  designationId String?
  profileData   Json?
  status        UserStatus @default(INVITED)
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant                  Tenant?                 @relation(fields: [tenantId], references: [id])
  customRole              CustomRole?             @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  department              Department?             @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation             Designation?            @relation(fields: [designationId], references: [id], onDelete: SetNull)
  firmMemberships         UserFirmMembership[]
  projectMemberships      UserProjectMembership[]
  firmCustomFields        FirmCustomField[]
  createdAuditEvents      AuditEvent[]            @relation("AuditActor")
  createdOwnershipRecords OwnershipRecord[]       @relation("OwnershipRecordCreator")

  @@index([tenantId, role])
  @@index([customRoleId])
  @@index([departmentId])
  @@index([designationId])
}

model Department {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  designations Designation[]
  roles        CustomRole[]
  users        User[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Designation {
  id           String   @id @default(cuid())
  tenantId     String
  departmentId String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department Department   @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  roles      CustomRole[]
  users      User[]

  @@unique([departmentId, name])
  @@index([tenantId])
  @@index([departmentId])
}

model CustomRole {
  id            String   @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  baseRole      Role     @default(VIEWER)
  permissions   Json
  departmentId  String?
  designationId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department  Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  designation Designation? @relation(fields: [designationId], references: [id], onDelete: SetNull)
  users       User[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([departmentId])
  @@index([designationId])
}

model UserFieldDefinition {
  id        String        @id @default(cuid())
  tenantId  String
  label     String
  key       String
  type      UserFieldType
  required  Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId])
}

model FirmCustomField {
  id          String   @id @default(cuid())
  ownerUserId String
  label       String
  key         String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner User @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)

  @@unique([ownerUserId, key])
  @@index([ownerUserId])
}

model UserFirmMembership {
  id          String   @id @default(cuid())
  userId      String
  tenantId    String
  role        Role
  allProjects Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([userId, tenantId])
  @@index([tenantId])
}

model UserProjectMembership {
  id        String   @id @default(cuid())
  userId    String
  tenantId  String
  projectId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId, tenantId])
  @@index([tenantId, projectId])
}

model Project {
  id                  String    @id @default(cuid())
  tenantId            String
  name                String
  city                String
  state               String?
  address             String?
  developmentLicenses Json?
  reraNumber          String?
  landAreaAcres       Decimal?  @db.Decimal(14, 4)
  landAreaSqft        Decimal?  @db.Decimal(14, 2)
  siteContactPhone    String?
  totalPlots          Int?
  customFields        Json?
  whatsappShareText   String?
  status              String    @default("ACTIVE")
  budgetInr           Decimal?  @db.Decimal(14, 2)
  spentInr            Decimal?  @db.Decimal(14, 2)
  progressPct         Int       @default(0)
  startedAt           DateTime?
  handoverAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant            Tenant                  @relation(fields: [tenantId], references: [id])
  phases            Phase[]
  blocks            Block[]
  plots             Plot[]
  cadFiles          CadFile[]
  siteAssets        SiteAsset[]
  boqItems          BOQItem[]
  marketingTasks    MarketingTask[]
  documentTemplates DocumentTemplate[]
  approvalDocuments ApprovalDocument[]
  userMemberships   UserProjectMembership[]

  @@index([tenantId])
}

model ProjectFileField {
  id         String   @id @default(cuid())
  tenantId   String
  label      String
  key        String
  section    String   @default("PROJECT_FILES")
  parentId   String?
  logoFileId String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parent   ProjectFileField?  @relation("ProjectMapSubFields", fields: [parentId], references: [id], onDelete: Cascade)
  children ProjectFileField[] @relation("ProjectMapSubFields")

  @@unique([tenantId, section, key])
  @@index([tenantId, section])
  @@index([parentId])
}

model LetterFieldCategory {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  key       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fields LetterFieldDefinition[]

  @@unique([tenantId, key])
  @@index([tenantId])
}

model LetterFieldDefinition {
  id         String   @id @default(cuid())
  categoryId String
  label      String
  key        String
  mapping    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category LetterFieldCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, key])
  @@index([categoryId])
}

model Phase {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  name      String
  sequence  Int      @default(0)
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])

  @@index([tenantId, projectId])
}

model Block {
  id        String   @id @default(cuid())
  tenantId  String
  projectId String
  name      String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id])
  plots     Plot[]

  @@index([tenantId, projectId])
}

model Owner {
  id        String    @id @default(cuid())
  tenantId  String
  type      OwnerType
  name      String
  email     String?
  phone     String?
  address   String?
  kyc       Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  tenant           Tenant            @relation(fields: [tenantId], references: [id])
  plots            Plot[]            @relation("CurrentPlotOwner")
  ownershipRecords OwnershipRecord[]

  @@index([tenantId, phone])
}

model Plot {
  id             String     @id @default(cuid())
  tenantId       String
  projectId      String
  blockId        String?
  code           String
  label          String?
  areaSqft       Decimal?   @db.Decimal(12, 2)
  areaSqYards    Decimal?   @db.Decimal(12, 2)
  priceInr       Decimal?   @db.Decimal(14, 2)
  primeLocation  String?
  allottedBy     String?
  dimensions     String?
  boundaries     Json?
  status         PlotStatus @default(COMPANY_OWNED)
  facing         String?
  geometry       Json?
  currentOwnerId String?
  ownerVisible   Boolean    @default(true)
  archivedAt     DateTime?
  archiveReason  String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  project          Project           @relation(fields: [projectId], references: [id])
  block            Block?            @relation(fields: [blockId], references: [id])
  currentOwner     Owner?            @relation("CurrentPlotOwner", fields: [currentOwnerId], references: [id])
  ownershipRecords OwnershipRecord[]
  registryRecords  RegistryRecord[]
  checklistItems   ChecklistItem[]

  @@unique([tenantId, projectId, code])
  @@index([tenantId, currentOwnerId])
  @@index([tenantId, projectId, archivedAt])
}

model OwnershipRecord {
  id                 String        @id @default(cuid())
  tenantId           String
  plotId             String
  ownerId            String?
  kind               OwnershipKind
  amountInr          Decimal?      @db.Decimal(14, 2)
  sharePct           Decimal?      @db.Decimal(5, 2)
  documentId         String?
  notes              String?
  paymentMode        String?
  extraDetails       Json?
  effectiveAt        DateTime      @default(now())
  createdById        String?
  cancelledAt        DateTime?
  cancelledById      String?
  cancellationReason String?
  createdAt          DateTime      @default(now())

  plot      Plot   @relation(fields: [plotId], references: [id])
  owner     Owner? @relation(fields: [ownerId], references: [id])
  createdBy User?  @relation("OwnershipRecordCreator", fields: [createdById], references: [id])

  @@index([tenantId, plotId, effectiveAt])
  @@index([tenantId, plotId, cancelledAt])
}

model RegistryRecord {
  id                String    @id @default(cuid())
  tenantId          String
  plotId            String
  status            String
  registryNo        String?
  registryDate      DateTime?
  registeredOwnerId String?
  fileAssetId       String?
  notes             String?
  createdById       String?
  archivedAt        DateTime?
  archivedById      String?
  archiveReason     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  plot              Plot      @relation(fields: [plotId], references: [id])

  @@index([tenantId, plotId])
  @@index([tenantId, plotId, archivedAt])
  @@index([tenantId, registeredOwnerId])
  @@index([tenantId, fileAssetId])
}

model CadFile {
  id            String    @id @default(cuid())
  tenantId      String
  projectId     String?
  parentType    CadScope
  parentId      String
  format        CadFormat
  status        CadStatus @default(UPLOADED)
  originalName  String
  storageKey    String
  version       Int       @default(1)
  errorMessage  String?
  processingLog Json?
  uploadedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project        Project?           @relation(fields: [projectId], references: [id])
  scenes         CadScene[]
  analysis       CadAnalysis?
  publishBatches CadPublishBatch[]
  versions       CadVersion[]
  reviewIssues   CadReviewIssue[]
  extractionRuns CadExtractionRun[]
  overlays       CadOverlay[]

  @@index([tenantId, parentType, parentId])
}

model CadOverlay {
  id           String   @id @default(cuid())
  tenantId     String
  cadFileId    String
  kind         String
  label        String?
  sourceHandle String?
  geometry     Json?
  metadata     Json?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cadFile CadFile @relation(fields: [cadFileId], references: [id])

  @@index([tenantId, cadFileId, kind])
}

model CadExtractionRun {
  id                  String              @id @default(cuid())
  tenantId            String
  cadFileId           String
  parserEngine        String
  parserVersion       String
  sourceSha256        String
  drawingUnits        String?
  bounds              Json?
  expectedEntityCount Int
  expectedChunkCount  Int
  receivedChunks      Json
  manifest            Json
  status              CadExtractionStatus @default(CREATED)
  warnings            Json?
  errorMessage        String?
  createdById         String
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  completedAt         DateTime?

  cadFile CadFile @relation(fields: [cadFileId], references: [id])

  @@index([tenantId, cadFileId, createdAt])
  @@index([tenantId, status])
}

model CadAnalysis {
  id                     String    @id @default(cuid())
  tenantId               String
  cadFileId              String    @unique
  discipline             String    @default("AUTO")
  sourceKind             String?
  pageNumber             Int       @default(1)
  proposedRegion         Json?
  confirmedRegion        Json?
  excludedRegions        Json?
  expectedCounts         Json?
  scaleCalibration       Json?
  inspection             Json?
  rawArtifactKey         String?
  previewArtifactKey     String?
  setupConfirmedAt       DateTime?
  calibrationConfirmedAt DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  cadFile CadFile @relation(fields: [cadFileId], references: [id])

  @@index([tenantId, cadFileId])
}

model CadScene {
  id          String    @id @default(cuid())
  tenantId    String
  cadFileId   String
  scope       CadScope
  parentId    String
  bounds      Json
  units       String    @default("feet")
  sceneJson   Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  cadFile        CadFile           @relation(fields: [cadFileId], references: [id])
  layers         CadLayer[]
  entities       CadEntity[]
  publishBatches CadPublishBatch[]

  @@index([tenantId, scope, parentId])
}

model CadLayer {
  id       String   @id @default(cuid())
  tenantId String
  sceneId  String
  name     String
  color    String?
  visible  Boolean  @default(true)
  purpose  String?
  metadata Json?
  scene    CadScene @relation(fields: [sceneId], references: [id])

  @@index([tenantId, sceneId])
}

model CadEntity {
  id           String        @id @default(cuid())
  tenantId     String
  sceneId      String
  layerId      String?
  type         CadEntityType
  label        String?
  confidence   Decimal       @db.Decimal(5, 2)
  geometry     Json
  measurements Json?
  validation   Json?
  sourceHandle String?
  sourceLayer  String?
  status       String        @default("SUGGESTED")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  scene        CadScene      @relation(fields: [sceneId], references: [id])
  spatialLinks SpatialLink[]

  @@index([tenantId, sceneId, type])
}

model CadReviewIssue {
  id        String          @id @default(cuid())
  tenantId  String
  cadFileId String
  entityId  String?
  severity  InsightSeverity @default(MEDIUM)
  code      String
  message   String
  blocking  Boolean         @default(false)
  metadata  Json?
  resolved  Boolean         @default(false)
  createdAt DateTime        @default(now())
  cadFile   CadFile         @relation(fields: [cadFileId], references: [id])

  @@index([tenantId, cadFileId, resolved])
}

model CadVersion {
  id          String    @id @default(cuid())
  tenantId    String
  cadFileId   String
  version     Int
  status      CadStatus
  comparison  Json?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  cadFile     CadFile   @relation(fields: [cadFileId], references: [id])

  @@unique([cadFileId, version])
  @@index([tenantId, cadFileId])
}

model CadPublishBatch {
  id             String    @id @default(cuid())
  tenantId       String
  cadFileId      String
  sceneId        String?
  status         String    @default("PUBLISHED")
  summary        Json?
  publishedById  String?
  publishedAt    DateTime  @default(now())
  rolledBackById String?
  rolledBackAt   DateTime?
  rollbackReason String?
  createdAt      DateTime  @default(now())

  cadFile      CadFile       @relation(fields: [cadFileId], references: [id])
  scene        CadScene?     @relation(fields: [sceneId], references: [id], onDelete: SetNull)
  spatialLinks SpatialLink[]

  @@index([tenantId, cadFileId, publishedAt])
}

model SpatialLink {
  id             String           @id @default(cuid())
  tenantId       String
  cadEntityId    String
  recordType     String
  recordId       String
  publishBatchId String?
  linkConfidence Decimal          @db.Decimal(5, 2)
  createdAt      DateTime         @default(now())
  entity         CadEntity        @relation(fields: [cadEntityId], references: [id])
  publishBatch   CadPublishBatch? @relation(fields: [publishBatchId], references: [id])

  @@index([tenantId, recordType, recordId])
  @@index([tenantId, publishBatchId])
}

model FileAsset {
  id                 String                  @id @default(cuid())
  tenantId           String
  storageKey         String
  storageProvider    FileStorageProvider     @default(S3)
  fallbackStorageKey String?
  fileName           String
  mimeType           String
  sizeBytes          Int
  visibility         FileVisibility          @default(ADMIN_ONLY)
  documentType       RealEstateDocumentType?
  documentNo         String?
  documentDate       DateTime?
  notes              String?
  ownerType          String?
  ownerId            String?
  categoryKey        String?
  uploadedById       String?
  version            Int                     @default(1)
  previousFileId     String?
  deletedAt          DateTime?
  deletedById        String?
  deleteReason       String?
  createdAt          DateTime                @default(now())
  tenant             Tenant                  @relation(fields: [tenantId], references: [id])

  @@index([tenantId, ownerType, ownerId])
  @@index([tenantId, ownerType, ownerId, categoryKey])
  @@index([tenantId, deletedAt])
}

model DocumentTemplate {
  id             String   @id @default(cuid())
  tenantId       String
  projectId      String?
  sourceFileId   String?
  name           String
  type           String
  body           String
  variables      Json?
  editorMode     String   @default("HTML")
  analysisStatus String   @default("READY")
  layoutData     Json?
  analysisError  String?
  layoutVersion  Int      @default(1)
