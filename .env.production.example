NODE_ENV="production"
NEXT_TELEMETRY_DISABLED="1"

DATABASE_URL="postgresql://kalman:change-me@postgres:5432/kalman_estate?schema=public"
DIRECT_URL="postgresql://kalman:change-me@postgres:5432/kalman_estate?schema=public"
JWT_SECRET="replace-with-a-long-random-production-secret"
SESSION_COOKIE_SECURE="false"

POSTGRES_DB="kalman_estate"
POSTGRES_USER="kalman"
POSTGRES_PASSWORD="change-me"

REDIS_URL="redis://redis:6379"

S3_ENDPOINT=""
S3_REGION="ap-south-1"
S3_BUCKET="kalman-estate-os-production"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ALLOW_IAM_ROLE="false"
FILE_STORAGE_DRIVER="s3_with_local_fallback"
LOCAL_STORAGE_ROOT="/app/storage"

AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

PYTHON_BIN="/usr/bin/python3"
TESSERACT_BIN="/usr/bin/tesseract"
MAX_CAD_UPLOAD_MB="100"
CAD_EXTRACTION_TIMEOUT_MS="900000"
CAD_PDF_RENDER_SCALE="2"
CAD_CELL_OCR_LIMIT="700"
CAD_OCR_TIMEOUT_SECONDS="600"
CAD_EXTRACTOR_MAX_OUTPUT_MB="100"
MAX_PDF_CAD_ENTITIES="25000"
ODA_CONVERTER_BIN="/opt/oda/ODAFileConverter"
ODA_APPIMAGE_URL=""

CRM_BASE_URL=""
