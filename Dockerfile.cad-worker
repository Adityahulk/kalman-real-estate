FROM node:22-bookworm-slim
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PYTHON_BIN=/usr/bin/python3
ENV OMP_NUM_THREADS=1
ENV OPENBLAS_NUM_THREADS=1
ENV MKL_NUM_THREADS=1
ENV NUMEXPR_NUM_THREADS=1
ENV VECLIB_MAXIMUM_THREADS=1

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    openssl \
    python3 \
    python3-pip \
    libfuse2 \
    libgl1 \
    libglib2.0-0 \
    libxrender1 \
    libxext6 \
    libsm6 \
    libice6 \
    libfontconfig1 \
    libxkbcommon-x11-0 \
    libxcb-cursor0 \
    libxcb-util1 \
    libgomp1 \
    tesseract-ocr \
  && rm -rf /var/lib/apt/lists/*

RUN python3 -m pip install --break-system-packages --no-cache-dir \
    ezdxf==1.4.4 \
    PyMuPDF==1.27.2.3 \
    numpy==1.26.4 \
    Pillow==11.0.0 \
    Shapely==2.1.1 \
    opencv-python-headless==4.10.0.84 \
    paddlepaddle==2.6.2 \
    paddleocr==2.9.1

RUN python3 -c "from paddleocr import PaddleOCR; PaddleOCR(use_angle_cls=True, lang='en', show_log=False)"

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 nextjs \
  && mkdir -p /app/storage /app/.paddleocr \
  && if [ -d /root/.paddleocr ]; then cp -R /root/.paddleocr/. /app/.paddleocr/; fi \
  && chown -R nextjs:nodejs /app/storage /app/.paddleocr

ARG ODA_APPIMAGE_URL=""
RUN mkdir -p /opt/oda \
  && if [ -n "$ODA_APPIMAGE_URL" ]; then \
    curl -fsSL "$ODA_APPIMAGE_URL" -o /tmp/ODAFileConverter.AppImage; \
    chmod +x /tmp/ODAFileConverter.AppImage; \
    cd /opt/oda; \
    /tmp/ODAFileConverter.AppImage --appimage-extract >/dev/null 2>&1 || true; \
    if [ -x /opt/oda/squashfs-root/AppRun ]; then \
      ln -sf /opt/oda/squashfs-root/AppRun /opt/oda/ODAFileConverter; \
    else \
      cp /tmp/ODAFileConverter.AppImage /opt/oda/ODAFileConverter; \
    fi; \
    chmod +x /opt/oda/ODAFileConverter; \
  else \
    echo "ODA_APPIMAGE_URL not provided; DWG conversion will stay disabled until ODA_CONVERTER_BIN points to a mounted/installed converter."; \
  fi

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY --chown=nextjs:nodejs . .
RUN npx prisma generate

ENV HOME=/app
USER nextjs
CMD ["npm", "run", "worker:cad"]
